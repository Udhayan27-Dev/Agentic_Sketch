# ==============================================================================
# SketchCAD Agent Configuration - Qwen on DGX via SSH Port Forwarding
# ==============================================================================
# Endpoint forwarded from DGX to localhost:8100:
# ssh -N -L 8100:localhost:8100 user@dgx-ip
SKETCHCAD_MODEL=openai/qwen3.8-flash-next
OPENAI_BASE_URL=http://127.0.0.1:8100/v1
OPENAI_API_BASE=http://127.0.0.1:8100/v1
OPENAI_API_KEY=EMPTY

# CAD Backend configuration: 'cadcraft' (default) or 'freecad'
CAD_BACKEND=cadcraft
SKETCHCAD_PACE_SECONDS=0.0
SKETCHCAD_MULTIMODAL=1
