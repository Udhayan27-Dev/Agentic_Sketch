# Model configuration (Gemini or OpenRouter via LiteLLM)
SKETCHCAD_MODEL=openrouter/google/gemma-4-31b-it:free

# Google Gemini API key (if using Gemini models)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenRouter API key (if using OpenRouter models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
